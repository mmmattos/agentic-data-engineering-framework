   "source": [
    "## 9. Read Parquet Outputs with PySpark"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql import SparkSession\n",
    "\n",
    "spark = SparkSession.builder.getOrCreate()\n",
    "\n",
    "# Determine path based on cloud provider\n",
    "if os.getenv(\"CLOUD_PROVIDER\") == \"gcp\":\n",
    "    bucket = os.getenv(\"GCS_BUCKET\", \"my-data-lake\")\n",
    "    gold_path = f\"gs://{bucket}/gold/sales_aggregated/\"\n",
    "else:\n",
    "    gold_path = \"data/gold/sales_aggregated/\"\n",
    "\n",
    "try:\n",
    "    # Read revenue by product\n",
    "    revenue_by_product = spark.read.parquet(f\"{gold_path}revenue_by_product\")\n",
    "    print(\"📊 Revenue by Product:\")\n",
    "    revenue_by_product.show(10)\n",
    "    \n",
    "    # Read daily trend\n",
    "    daily_trend = spark.read.parquet(f\"{gold_path}daily_trend\")\n",
    "    print(\"\\n📈 Daily Sales Trend:\")\n",
    "    daily_trend.orderBy(\"date\").show(10)\n",
    "    \n",
    "    # Read revenue by region\n",
    "    revenue_by_region = spark.read.parquet(f\"{gold_path}revenue_by_region\")\n",
    "    print(\"\\n🌍 Revenue by Region:\")\n",
    "    revenue_by_region.show()\n",
    "except Exception as e:\n",
    "    print(f\"⚠️  Could not read outputs: {e}\")\n",
    "    print(\"   Make sure the pipeline ran successfully.\")"
   ]
  },
