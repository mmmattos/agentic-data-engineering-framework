   "source": [
    "# Agentic Glue ETL Pipeline - GCP Ready\n",
    "\n",
    "This notebook demonstrates a complete Bronze → Silver → Gold ETL pipeline using:\n",
    "- **Groq LLM** (via LangChain) for code generation\n",
    "- **PySpark** for data processing\n",
    "- **Parquet** on GCS or **BigQuery** for storage\n",
    "\n",
    "## Pipeline Flow:\n",
    "1. **Bronze Layer**: Raw data ingestion from CSV/JSON files (local or GCS)\n",
    "2. **Silver Layer**: Data cleaning, validation, deduplication\n",
    "3. **Gold Layer**: Aggregations and business metrics\n",
    "4. **Output**: Parquet on GCS or BigQuery tables\n",
    "\n",
    "## Cloud Provider Support\n",
    "- **Local**: Runs with local Spark and local files\n",
    "- **GCP**: Runs on Dataproc with GCS and BigQuery"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup and Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add project root to path\n",
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.insert(0, str(Path.cwd().parent))\n",
    "\n",
    "# Import our agents\n",
    "from agents.code_generator_agent import CodeGeneratorAgent\n",
    "from agents.validator_agent import ValidatorAgent\n",
    "from agents.executor_agent import ExecutorAgent\n",
    "\n",
    "# Other imports\n",
    "import os\n",
    "import pandas as pd\n",
    "from datetime import datetime\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "# Load environment variables\n",
    "load_dotenv()\n",
    "\n",
    "print(\"✅ All imports successful\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Verify Groq connection\n",
    "from groq import Groq\n",
    "client = Groq(api_key=os.getenv(\"GROQ_API_KEY\"))\n",
    "response = client.chat.completions.create(\n",
    "    model=\"llama-3.3-70b-versatile\",\n",
    "    messages=[{\"role\": \"user\", \"content\": \"Reply with: Groq is ready\"}],\n",
    "    max_tokens=20\n",
    ")\n",
    "print(f\"✅ {response.choices[0].message.content}\")\n",
    "\n",
    "# Check cloud provider\n",
    "cloud = os.getenv(\"CLOUD_PROVIDER\", \"local\")\n",
    "print(f\"☁️  Cloud Provider: {cloud}\")\n",
    "if cloud == \"gcp\":\n",
    "    print(f\"   Project: {os.getenv('GCP_PROJECT', 'Not set')}\")\n",
    "    print(f\"   Region: {os.getenv('GCP_REGION', 'Not set')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Initialize Agents with GCP Config"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# GCP-specific overrides\n",
    "GCP_CONFIG_OVERRIDES = {\n",
    "    \"cloud_provider\": \"gcp\",\n",
    "    \"source\": {\n",
    "        \"type\": \"file\",\n",
    "        \"environment\": \"gcp\",\n",
    "        \"format\": \"csv\",\n",
    "        \"path\": \"gs://your-bucket/raw/\",\n",
    "        \"options\": {\n",
    "            \"header\": \"true\",\n",
    "            \"inferSchema\": \"true\"\n",
    "        }\n",
    "    },\n",
    "    \"gold_output_format\": \"parquet\",  # or \"bigquery\"\n",
    "    \"gcp\": {\n",
    "        \"compute\": {\n",
    "            \"engine\": \"dataproc\",\n",
    "            \"region\": \"us-central1\"\n",
    "        },\n",
    "        \"warehouse\": {\n",
    "            \"type\": \"bigquery\",\n",
    "            \"project\": os.getenv(\"GCP_PROJECT\", \"my-project\"),\n",
    "            \"dataset\": \"gold_analytics\"\n",
    "        },\n",
    "        \"storage\": {\n",
    "            \"bucket\": os.getenv(\"GCS_BUCKET\", \"my-data-lake\"),\n",
    "            \"bronze_path\": f\"gs://{os.getenv('GCS_BUCKET', 'my-data-lake')}/bronze/\",\n",
    "            \"silver_path\": f\"gs://{os.getenv('GCS_BUCKET', 'my-data-lake')}/silver/\",\n",
    "            \"gold_path\": f\"gs://{os.getenv('GCS_BUCKET', 'my-data-lake')}/gold/\"\n",
    "        }\n",
    "    }\n",
    "}\n",
    "\n",
    "# For local development, use local config\n",
    "LOCAL_CONFIG_OVERRIDES = {\n",
    "    \"cloud_provider\": \"aws\",\n",
    "    \"source\": {\n",
    "        \"type\": \"file\",\n",
    "        \"environment\": \"offline\",\n",
    "        \"path\": \"data/raw/\"\n",
    "    },\n",
    "    \"gold_output_format\": \"parquet\"\n",
    "}\n",
    "\n",
    "# Choose config based on environment\n",
    "cloud = os.getenv(\"CLOUD_PROVIDER\", \"local\")\n",
    "if cloud == \"gcp\":\n",
    "    overrides = GCP_CONFIG_OVERRIDES\n",
    "else:\n",
    "    overrides = LOCAL_CONFIG_OVERRIDES\n",
    "\n",
    "# Initialize agents\n",
    "code_gen = CodeGeneratorAgent(use_case_overrides=overrides)\n",
    "validator = ValidatorAgent()\n",
    "executor = ExecutorAgent()\n",
    "\n",
    "print(\"✅ Agents initialized with config:\")\n",
    "print(f\"   Cloud Provider: {code_gen.config.get('cloud_provider', 'unknown')}\")\n",
    "print(f\"   Environment: {code_gen.config.get('source', {}).get('environment', 'unknown')}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Create Sample Data (For Testing)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create sample sales data\n",
    "import random\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "products = ['Laptop', 'Mouse', 'Keyboard', 'Monitor', 'Desk', 'Chair', 'Headphones']\n",
    "regions = ['North', 'South', 'East', 'West']\n",
    "\n",
    "data = []\n",
    "start_date = datetime(2024, 1, 1)\n",
    "\n",
    "for i in range(1000):\n",
    "    date = start_date + timedelta(days=random.randint(0, 90))\n",
    "    product = random.choice(products)\n",
    "    region = random.choice(regions)\n",
    "    quantity = random.randint(1, 10)\n",
    "    price = round(random.uniform(10, 1000), 2)\n",
    "    amount = round(quantity * price, 2)\n",
    "    \n",
    "    # Add some nulls and duplicates for testing\n",
    "    if i % 50 == 0:\n",
    "        product = None\n",
    "    if i % 100 == 0:\n",
    "        data.append([date, product, region, quantity, price, amount])\n",
    "    \n",
    "    data.append([date, product, region, quantity, price, amount])\n",
    "\n",
    "df = pd.DataFrame(data, columns=['transaction_date', 'product', 'region', 'quantity', 'unit_price', 'total_amount'])\n",
    "\n",
    "# Save locally (for local testing) or to GCS (for GCP)\n",
    "os.makedirs('data/raw', exist_ok=True)\n",
    "local_path = 'data/raw/sales_transactions.csv'\n",
    "df.to_csv(local_path, index=False)\n",
    "print(f\"✅ Sample data created locally: {local_path}\")\n",
    "\n",
    "# If on GCP, upload to GCS\n",
    "if os.getenv(\"CLOUD_PROVIDER\") == \"gcp\":\n",
    "    try:\n",
    "        from google.cloud import storage\n",
    "        bucket_name = os.getenv(\"GCS_BUCKET\", \"my-data-lake\")\n",
    "        client = storage.Client()\n",
    "        bucket = client.bucket(bucket_name)\n",
    "        blob = bucket.blob(\"raw/sales_transactions.csv\")\n",
    "        blob.upload_from_filename(local_path)\n",
    "        print(f\"✅ Uploaded to GCS: gs://{bucket_name}/raw/sales_transactions.csv\")\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️  Could not upload to GCS: {e}\")\n",
    "        print(\"   Continuing with local file only\")\n",
    "\n",
    "print(f\"\\n📊 Data Statistics:\")\n",
    "print(f\"   - Total records: {len(df):,}\")\n",
    "print(f\"   - Null product_ids: {df['product'].isna().sum():,}\")\n",
    "print(f\"   - Negative amounts: {(df['total_amount'] < 0).sum():,}\")\n",
    "print(f\"\\n📋 First 5 rows:\")\n",
    "df.head()"
   ]
  },
